{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "law-sc500-sentinel",
      "metadata": { "description": "Name of the Log Analytics workspace." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for the workspace." }
    },
    "sku": {
      "type": "string",
      "defaultValue": "PerGB2018",
      "allowedValues": ["Free", "PerGB2018", "CapacityReservation"],
      "metadata": { "description": "Pricing tier. PerGB2018 is recommended for most lab scenarios." }
    },
    "retentionInDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 7,
      "maxValue": 730,
      "metadata": { "description": "Number of days to retain data. 30 days minimizes costs for lab." }
    },
    "dailyQuotaGb": {
      "type": "int",
      "defaultValue": 1,
      "metadata": { "description": "Daily ingestion cap in GB. Prevents unexpected cost overruns." }
    }
  },
  "variables": {
    "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[parameters('workspaceName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Purpose": "SC-500 Learning Lab",
        "Domain": "03-Security-Operations"
      },
      "properties": {
        "sku": {
          "name": "[parameters('sku')]"
        },
        "retentionInDays": "[parameters('retentionInDays')]",
        "workspaceCapping": {
          "dailyQuotaGb": "[parameters('dailyQuotaGb')]"
        },
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        },
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    }
  ],
  "outputs": {
    "workspaceId": {
      "type": "string",
      "value": "[variables('workspaceId')]"
    },
    "workspaceName": {
      "type": "string",
      "value": "[parameters('workspaceName')]"
    },
    "workspaceResourceId": {
      "type": "string",
      "value": "[variables('workspaceId')]"
    },
    "primarySharedKey": {
      "type": "string",
      "value": "[listKeys(variables('workspaceId'), '2022-10-01').primarySharedKey]"
    },
    "customerId": {
      "type": "string",
      "value": "[reference(variables('workspaceId'), '2022-10-01').customerId]"
    }
  }
}
