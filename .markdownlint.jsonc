{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,
  // Allow long lines (tables, KQL, ARM/Bicep code, URLs).
  "MD013": false,
  // Allow inline HTML (Mermaid, details/summary, badges).
  "MD033": false,
  // First line does not have to be a top-level heading in every file (labs, includes).
  "MD041": false,
  // Allow duplicate headings across sections (e.g. "Objectives" per lab).
  "MD024": { "siblings_only": true },
  // Ordered lists can use 1. everywhere.
  "MD029": { "style": "one" },
  // Table pipe alignment style is not enforced (unaligned pipes are acceptable).
  "MD060": false
}
